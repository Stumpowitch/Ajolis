{
  "singleQuote": true,
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": { "parser": "astro" }
    },
    {
      "files": "*.code-workspace",
      "options": { "parser": "json" }
    },
    {
      "files": "*.mdc",
      "options": { "parser": "markdown" }
    }
  ]
}
