---
import SiteHeader from '@/components/SiteHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  noindex
  title="Seite nicht gefunden — Ajolis"
  description="Diese Seite konnte nicht gefunden werden. Zurück zur Startseite von Ajolis."
>
  <SiteHeader />
  <main id="main-content" class="wrapper">
    <p class="eyebrow">404 / Hier ist noch nichts</p>
    <h1>Ein kleiner Umweg.</h1>
    <p>Diese Seite gibt es nicht. Aber hier geht es weiter.</p>
    <a class="button" href={base}>
      Zur Startseite{' '}
      <span class="button-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  </main>
</BaseLayout>

<style>
  main {
    padding-block: 5rem;
  }
  h1 {
    margin-block: 1rem;
    font-size: clamp(2rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }
  main > p:not(.eyebrow) {
    margin-bottom: 2rem;
    color: var(--muted);
  }
</style>
