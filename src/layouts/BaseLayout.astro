---
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const excludeFromSearch = noindex || base !== '/';
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {excludeFromSearch && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f6f4ee" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <slot />
  </body>
</html>
