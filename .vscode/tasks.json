{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ajolis: install",
      "type": "process",
      "command": "direnv",
      "args": ["exec", "${workspaceFolder}", "just", "install"],
      "detail": "Install locked dependencies",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "label": "$(cloud-download) Install",
          "detail": "Install locked dependencies"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Ajolis: dev",
      "type": "process",
      "command": "direnv",
      "args": ["exec", "${workspaceFolder}", "just", "dev"],
      "detail": "Start the development server",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "label": "$(play) Dev",
          "detail": "Start the development server"
        }
      },
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "> astro (dev|preview)",
          "endsPattern": "Local.*http://|[Ss]erver running at http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "isBackground": true
    },
    {
      "label": "Ajolis: build",
      "type": "process",
      "command": "direnv",
      "args": ["exec", "${workspaceFolder}", "just", "build"],
      "detail": "Build the static website",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "label": "$(package) Build",
          "detail": "Build the static website"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Ajolis: preview",
      "type": "process",
      "command": "direnv",
      "args": ["exec", "${workspaceFolder}", "just", "preview"],
      "detail": "Build and preview production output",
      "options": {
        "cwd": "${workspaceFolder}",
        "statusbar": {
          "hide": false,
          "label": "$(open-preview) Preview",
          "detail": "Build and preview production output"
        }
      },
      "problemMatcher": {
        "owner": "astro",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "> astro (dev|preview)",
          "endsPattern": "Local.*http://|[Ss]erver running at http://"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "isBackground": true
    },
